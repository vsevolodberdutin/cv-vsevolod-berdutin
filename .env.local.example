# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ===========================================
# OpenAI API Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Application URLs
# ===========================================
# Base URL for API requests (development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket server URL for real-time data
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ===========================================
# Module Federation
# ===========================================
# URL for DeFi Dashboard remote module
NEXT_PUBLIC_DEFI_DASHBOARD_URL=http://localhost:3001

# URL for CV Portfolio remote module (if needed)
NEXT_PUBLIC_CV_PORTFOLIO_URL=http://localhost:3000

# ===========================================
# External APIs (Optional)
# ===========================================
# CoinGecko API for cryptocurrency data
# Get your API key from: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your-coingecko-api-key

# Binance WebSocket URL for real-time crypto prices
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# CryptoCompare API for market data
# Get your API key from: https://min-api.cryptocompare.com
CRYPTOCOMPARE_API_KEY=your-cryptocompare-api-key

# ===========================================
# Database (Optional - if you add persistence)
# ===========================================
# PostgreSQL database URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/cv_portfolio

# MongoDB connection string (alternative)
# Format: mongodb://user:password@host:port/database
MONGODB_URI=mongodb://localhost:27017/cv_portfolio

# ===========================================
# Authentication (Optional - if you add auth)
# ===========================================
# NextAuth secret for session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# NextAuth URL
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (if using GitHub authentication)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ===========================================
# Analytics (Optional)
# ===========================================
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# ===========================================
# Feature Flags
# ===========================================
# Enable/disable features in development
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_CV_UPLOAD=true
NEXT_PUBLIC_ENABLE_MODULE_FEDERATION=true

# ===========================================
# Development Settings
# ===========================================
# Enable debug mode for additional logging
DEBUG=false

# Node environment (development, production, test)
NODE_ENV=development

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# ===========================================
# Production Settings (for deployment)
# ===========================================
# Production API URL (update when deploying)
# NEXT_PUBLIC_API_URL=https://your-domain.com

# Production WebSocket URL (update when deploying)
# NEXT_PUBLIC_WS_URL=wss://your-domain.com

# ===========================================
# Security
# ===========================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting (requests per minute)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# Email Service (Optional - for contact form)
# ===========================================
# SendGrid API key
SENDGRID_API_KEY=your-sendgrid-api-key

# Contact form recipient email
CONTACT_EMAIL=vsevolodberdutin@gmail.com

# ===========================================
# File Storage (Optional - for CV uploads)
# ===========================================
# AWS S3 configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=cv-uploads

# Cloudinary configuration (alternative)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ===========================================
# Monitoring & Logging (Optional)
# ===========================================
# Sentry DSN for error tracking
SENTRY_DSN=your-sentry-dsn

# LogRocket app ID for session replay
LOGROCKET_APP_ID=your-logrocket-app-id

# ===========================================
# Notes
# ===========================================
# - Never commit .env.local to version control
# - Keep .env.local.example updated with new variables
# - Use strong, unique values for secrets in production
# - Rotate API keys regularly for security
# - For production, use environment variables from your hosting provider
# - Vercel: Use Environment Variables in project settings
# - Netlify: Use Environment Variables in site settings
# - Docker: Pass via docker-compose.yml or .env file
