# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# OpenAI API Configuration (REQUIRED)
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
# Used by: backend (chat feature in cv-portfolio)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Backend Server Configuration
# ===========================================
# Port for Express backend server (default: 8080)
PORT=8080

# Node environment (development, production)
NODE_ENV=development

# ===========================================
# Notes
# ===========================================
# - Never commit .env to version control (it is gitignored)
# - The OPENAI_API_KEY is the only required variable for the app to work
# - Backend runs on PORT 8080 by default
# - CV Portfolio frontend proxies API calls to backend via Vite config
