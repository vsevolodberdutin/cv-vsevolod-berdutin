# Environment Variables Example
# Copy this file to .env and fill in your values

# OpenAI API Key (required for CV Portfolio chat feature)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# WebSocket URL for real-time price updates
# For Docker: ws://backend:8080
# For local development: ws://localhost:8080
NEXT_PUBLIC_WS_URL=ws://backend:8080

# Node Environment
NODE_ENV=production

# WebSocket Server Port (Backend)
WS_PORT=8080
